# All LLM calls are routed through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=

# Three-model consensus panel used for both extraction and judging in the
# primary runs (January-February 2026):
MULTIMODEL_1=anthropic/claude-haiku-4.5
MULTIMODEL_2=openai/gpt-5-mini
MULTIMODEL_3=google/gemini-3-flash-preview

# Stability run (August 2026) separates the panels. Extraction:
#   EXTRACTION_MODEL_1=anthropic/claude-haiku-4.5
#   EXTRACTION_MODEL_2=openai/gpt-5.6-luna
#   EXTRACTION_MODEL_3=google/gemini-3.7-flash
# Judging:
#   JUDGE_MODEL_1=deepseek/deepseek-v4-flash-0731
#   JUDGE_MODEL_2=z-ai/glm-5.3-flash
#   JUDGE_MODEL_3=moonshotai/kimi-k3
# When unset, scripts fall back to MULTIMODEL_1/2/3.
